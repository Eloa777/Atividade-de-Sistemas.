#simple-loading-screen { --simple-loading-screen-bg: #f2f3f5; --simple-loading-screen-fg: #282c33; --simple-loading-screen-track: #dfe3e8; --simple-loading-screen-bar: #6f7681; }

#simple-loading-screen.lucid-theme-dark { --simple-loading-screen-bg: #14171a; --simple-loading-screen-fg: #ffffff; --simple-loading-screen-track: #4c535d; --simple-loading-screen-bar: #979ea8; }

#simple-loading-screen { position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; z-index: 9999; background-color: var(--simple-loading-screen-bg); display: flex; align-items: center; justify-content: center; flex-direction: column; opacity: 1; visibility: visible; transition: opacity 0.2s; }

#simple-loading-screen.simple-loading-screen-hiding { opacity: 0; visibility: hidden; transition: opacity 0.2s, visibility linear 0.2s; pointer-events: none; }

.simple-loading-screen-corner { position: absolute; max-width: 100%; max-height: 100%; pointer-events: none; }

.simple-loading-screen-corner-bl { bottom: 0px; left: 0px; }

.simple-loading-screen-corner-tr { top: 0px; right: 0px; transform: rotate(180deg); }

#simple-loading-screen-logo { color: var(--simple-loading-screen-fg); }

#simple-loading-screen-progress-track { margin-top: 24px; width: 160px; height: 3px; background-color: var(--simple-loading-screen-track); border-radius: 2px; overflow: hidden; }

#simple-loading-screen-progress-bar { height: 100%; background-color: var(--simple-loading-screen-bar); transform: scaleX(0); transform-origin: 0px center; }

@keyframes simple-loading-screen-progress { 
  0% { transform: scaleX(0); }
  100% { transform: scaleX(0.9); }
}

.simple-loading-screen-progress-active { animation: 7s ease-in 0s 1 normal forwards running simple-loading-screen-progress; }

#simple-loading-screen.simple-loading-screen-hiding #simple-loading-screen-progress-bar { animation: auto ease 0s 1 normal none running none; transform: scaleX(1); transition: transform 0.3s ease-in; }
